{
  "version": 2,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/participant", "destination": "/index.html" },
    { "source": "/participants", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
